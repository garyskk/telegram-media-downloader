+// ---- Download --------------------------------------------------------------
+
+export function releaseBase() {
+    const override = String(process.env.TGDL_CORE_RELEASE_URL || '').trim();
+    if (override) return override.replace(/\/+$/, '');
+    return `${RELEASES}/core-v${CORE_VERSION}`;
