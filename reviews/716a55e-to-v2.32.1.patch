+        await peer('health signature for another path → 401', 'GET', '/api/cluster/health', {
+            headers: sign({ method: 'GET', urlPath: '/api/cluster/health?x=1', key: KEYS.alpha }),
+            as: 'peer:alpha/signed-other-path',
