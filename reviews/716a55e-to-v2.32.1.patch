+
+function balancedArg(code, openIdx) {
+    // `openIdx` points at '('. Returns the text between the parens.
+    let depth = 0;
+    let quote = null;
+    for (let i = openIdx; i < code.length; i++) {
+        const c = code[i];
+        if (quote) {
+            if (c === '\\') {
+                i++;
+                continue;
+            }
+            if (c === quote) quote = null;
+            continue;
+        }
+        if (c === "'" || c === '"' || c === '`') {
+            quote = c;
+            continue;
+        }
