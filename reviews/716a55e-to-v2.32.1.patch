+    ['USERNAME_NOT_OCCUPIED', 'deleted'],
+    ['CHAT_FORBIDDEN', 'banned'],
+    ['USER_BANNED_IN_CHANNEL', 'banned'],
+    ['USER_KICKED', 'banned'],
+    ['USER_NOT_PARTICIPANT', 'left'],
+    ['CHANNEL_PUBLIC_GROUP_NA', 'restricted'],
