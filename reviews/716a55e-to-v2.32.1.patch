+func TestStatBatchOrderUnderParallelism(t *testing.T) {
+	root := t.TempDir()
+	var paths []string
+	for i := 0; i < 300; i++ {
+		p := filepath.Join(root, "d", strings.Repeat("n", i%7+1)+"-"+itoa3(i)+".bin")
+		if i%3 != 0 {
+			write(t, p, i)
+		}
+		paths = append(paths, p)
