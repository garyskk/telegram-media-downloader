+                    text: '#F5F5F5',
+                    textSecondary: '#8B9BAA',
+                    green: '#4FAE4E',
+                    red: '#E53935',
+                    orange: '#FF9800',
+                    lightBg: '#182533',
+                },
+            },
+        },
+    },
+    plugins: [],
+};
