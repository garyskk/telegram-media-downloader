+func TestWalkErrors(t *testing.T) {
+	root := t.TempDir()
+	r := roots(t, root)
+	evs, _, err := collect(t, r, filepath.Join(root, "missing"), WalkOptions{})
+	if err != nil {
+		t.Fatal(err)
