+    ['uptimeSec', 'process uptime'],
+    ['uptimeMs', 'process uptime'],
+    ['uptimeSeconds', 'process uptime'],
+    ['durationMs', 'wall-clock duration of a job/request'],
+    ['elapsedMs', 'wall-clock duration'],
