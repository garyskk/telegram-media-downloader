+        path: `${clip}?inline=1`,
+        headers: { ...admin, 'If-None-Match': CLIP_ETAG },
+    },
+    {
+        name: 'files If-None-Match list',
+        path: `${clip}?inline=1`,
+        headers: { ...admin, 'If-None-Match': `"x", ${CLIP_ETAG}` },
