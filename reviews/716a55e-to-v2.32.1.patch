+    it('no body wipes everything', async () => {
+        const t = h.t;
+        await runJob(t, 'thumbs/rebuild all', {
+            path: '/api/maintenance/thumbs/rebuild',
+            body: {},
+            prefix: 'thumbs_rebuild',
