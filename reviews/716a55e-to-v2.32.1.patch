+        t.recordWs('ws refresh-info', ws.drain(), { ignore: WS_IGNORE });
+        await t.exchange('refresh-info status done', 'GET', '/api/groups/refresh-info/status');
+        await t.exchange('refresh-info guest → 403', 'POST', '/api/groups/refresh-info', {
+            as: 'guest',
+            body: {},
+        });
