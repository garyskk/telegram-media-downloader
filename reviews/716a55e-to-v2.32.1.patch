+		return t
+	}
+	if jp.IntervalSec > 0 {
+		t.IntervalSec = jp.IntervalSec
+	}
+	if jp.TileW > 0 {
+		t.Width = jp.TileW
+	}
+	if jp.Cols > 0 {
+		t.Columns = jp.Cols
+	}
+	if jp.MaxTiles > 0 {
+		t.MaxTiles = jp.MaxTiles
+	}
+	if jp.Format != "" {
+		t.Format = jp.Format
+	}
+	if jp.Quality > 0 {
+		t.Quality = jp.Quality
+	}
+	return t
+}
