+/* ------------------------------------------------------------------
+ * Face overlay (image viewer)
+ *
+ * Boxes are absolutely positioned inside `#face-overlay-layer` which
+ * is `absolute inset-0` inside `#image-stage`. Coordinates come from
+ * JS as percentages of the natural image dimensions. CSS owns chrome.
+ * ------------------------------------------------------------------ */
+#face-overlay-layer {
+    position: absolute;
+    pointer-events: none;
+}
+#face-overlay-layer .face-box {
+    position: absolute;
+    border: 2px solid rgba(80, 160, 255, 0.9);
+    border-radius: 4px;
+    background: rgba(80, 160, 255, 0.05);
+    box-shadow:
+        0 0 0 1px rgba(0, 0, 0, 0.3) inset,
+        0 1px 6px rgba(0, 0, 0, 0.25);
+    pointer-events: auto;
+    cursor: default;
+    transition:
+        background 100ms ease-out,
+        border-color 100ms ease-out,
+        box-shadow 100ms ease-out;
+}
+#face-overlay-layer .face-box:hover,
+#face-overlay-layer .face-box:focus-visible {
+    background: rgba(80, 160, 255, 0.18);
+    border-color: rgba(130, 200, 255, 1);
+    box-shadow:
+        0 0 0 1px rgba(0, 0, 0, 0.3) inset,
+        0 0 12px rgba(80, 160, 255, 0.35);
+    outline: none;
+}
+#face-overlay-layer .face-label {
+    position: absolute;
+    left: 0;
+    bottom: calc(100% + 3px);
+    padding: 2px 6px;
+    background: rgba(0, 0, 0, 0.82);
+    color: #fff;
+    font-size: 10px;
+    line-height: 1.4;
+    font-weight: 500;
+    border-radius: 3px;
+    white-space: nowrap;
+    max-width: min(200px, 50vw);
+    overflow: hidden;
+    text-overflow: ellipsis;
+    pointer-events: none;
+    /* Fade in when the box is focused so the label doesn't clutter the
+     * default view on images with many faces. */
+    opacity: 0;
+    transition: opacity 80ms ease-out;
+}
+#face-overlay-layer .face-box:hover .face-label,
+#face-overlay-layer .face-box:focus-visible .face-label {
+    opacity: 1;
+}
+#face-overlay-layer .face-label.unlabeled {
+    background: rgba(0, 0, 0, 0.6);
+    color: rgba(255, 255, 255, 0.72);
+    font-style: italic;
+}
+
+/* Mobile — smaller tile and clamped label width. */
+@media (max-width: 480px) {
+    #video-sprite-preview[data-state="pending"] #video-sprite-frame {
+        width: 128px;
+        height: 72px;
+    }
+    #face-overlay-layer .face-label {
+        font-size: 9px;
+        padding: 1px 4px;
+    }
+}
+
+/* Live <video> snapshot canvas — shown while sprite is pending. */
+#video-sprite-snapshot {
+    position: absolute;
+    inset: 0;
+    width: 100%;
+    height: 100%;
+    background: #000;
+    image-rendering: -webkit-optimize-contrast;
+    image-rendering: crisp-edges;
+}
