+func rawGet(t *testing.T, base, path, extra string) string {
+	t.Helper()
+	u, _ := url.Parse(base)
+	c, err := net.Dial("tcp", u.Host)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c.Close()
+	fmt.Fprintf(c, "GET %s HTTP/1.1\r\nHost: x\r\n%s\r\nConnection: close\r\n\r\n", path, extra)
+	b, _ := io.ReadAll(c)
+	s := string(b)
+	if i := strings.Index(s, "\r\n\r\n"); i >= 0 {
+		s = s[:i+2]
+	}
+	return s
+}
