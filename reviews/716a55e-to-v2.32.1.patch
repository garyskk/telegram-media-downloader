+    return new Promise((resolve) => {
+        execFile(binPath, ['version'], { timeout: 10_000, windowsHide: true }, (err, stdout) => {
+            const m = /^tgdl-core (\S+)/.exec(String(stdout || ''));
+            resolve(err || !m ? null : m[1]);
