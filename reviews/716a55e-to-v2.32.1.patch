+});
+
+describe('bulk edits', () => {
+    it('disable flips enabled:false for known ids only', async () => {
+        const t = h.t;
+        await t.exchange('recovery/disable', 'POST', '/api/maintenance/recovery/disable', {
+            body: { ids: [LOST, 'no-such-group'] },
