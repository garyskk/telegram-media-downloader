+    'PATH',
+    'SystemRoot', // Winsock refuses to initialise without it
+    'WINDIR',
+    'TEMP',
+    'TMP',
+    'TMPDIR',
+    'HOME',
+    'USERPROFILE',
+    'LANG',
+    'LC_ALL',
+    'TZ',
+    'GOMAXPROCS',
+    'GOMEMLIMIT',
+    'GOGC',
+    'HASH_WORKER_POOL_SIZE',
+    'TGDL_CORE_LOG_LEVEL',
