+                rows: GAMMA_ROWS.filter((r) => r.id > since),
+                peerId: GAMMA_ID,
+                now: 1717200000000,
+            });
+        }
+        if (u.pathname === '/api/cluster/search/peer') {
+            const q = String(u.searchParams.get('q') || '').toLowerCase();
+            return json(200, {
+                rows: GAMMA_ROWS.filter((r) => r.file_name.toLowerCase().includes(q)),
+                peerId: GAMMA_ID,
