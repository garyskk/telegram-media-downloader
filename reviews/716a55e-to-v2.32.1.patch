+
+const FILTERS = [
+    { key: 'photos', icon: 'ri-image-line', label: () => i18nT('group.filter.photos', 'Photos') },
+    { key: 'videos', icon: 'ri-video-line', label: () => i18nT('group.filter.videos', 'Videos') },
+    {
+        key: 'files',
+        icon: 'ri-file-line',
+        label: () => i18nT('group.filter.files', 'Files / Documents'),
