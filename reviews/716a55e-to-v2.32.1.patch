+        await ex('sweep run', 'POST', '/api/cluster/sweep/run', { body: { minSize: 1024 } });
+        await ws.waitFor((m) => m.type === 'cluster_sweep_done' && m.kind === 'cluster_sweep');
+        t.recordWs('ws: sweep', ws.drain());
+        ws.close();
+        await until(
