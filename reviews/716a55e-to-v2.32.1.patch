diff --git a/docs/index.html b/docs/index.html
new file mode 100644
index 0000000..7efb2f5
--- /dev/null
+++ b/docs/index.html
@@ -0,0 +1,404 @@
+---
+layout: null
+title: Telegram Media Downloader
+description: Self-hosted Telegram media downloader with a fast web dashboard. Download and back up photos, videos and files from Telegram channels, groups and DMs. Docker, PWA, dedup, face clustering, cluster mode.
+permalink: /
+---
+{%- assign base = site.url | append: site.baseurl -%}
+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Telegram Media Downloader: self-hosted channel and group media downloader</title>
+<meta name="description" content="{{ page.description | escape }}">
+<link rel="canonical" href="{{ base }}/">
+<meta name="theme-color" content="#0b1424" media="(prefers-color-scheme: dark)">
+<meta name="theme-color" content="#f4f8fc" media="(prefers-color-scheme: light)">
+<link rel="icon" type="image/png" href="{{ '/assets/favicon.png' | relative_url }}">
+<meta property="og:type" content="website">
+<meta property="og:site_name" content="{{ site.title }}">
+<meta property="og:title" content="Telegram Media Downloader">
+<meta property="og:description" content="Self-hosted Telegram media downloader with a fast web dashboard. Docker, PWA, dedup, face clustering, cluster mode.">
+<meta property="og:url" content="{{ base }}/">
+<meta property="og:image" content="{{ base }}/assets/og.png">
+<meta property="og:image:width" content="1200">
+<meta property="og:image:height" content="630">
+<meta property="og:image:alt" content="The Telegram Media Downloader library view">
+<meta name="twitter:card" content="summary_large_image">
+<meta name="twitter:title" content="Telegram Media Downloader">
+<meta name="twitter:description" content="Self-hosted Telegram media downloader with a fast web dashboard.">
+<meta name="twitter:image" content="{{ base }}/assets/og.png">
+<link rel="preconnect" href="https://fonts.googleapis.com">
+<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
+<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap">
+{% include head_custom.html %}
+<script type="application/ld+json">
+{
+  "@context": "https://schema.org",
+  "@type": "FAQPage",
+  "mainEntity": [
+{%- for item in site.data.faq %}
+    {
+      "@type": "Question",
+      "name": {{ item.q | jsonify }},
+      "acceptedAnswer": { "@type": "Answer", "text": {{ item.a | markdownify | strip_html | strip | jsonify }} }
+    }{% unless forloop.last %},{% endunless %}
+{%- endfor %}
+  ]
+}
+</script>
+<style>
+:root {
+  --bg: #f4f8fc; --bg2: #ffffff; --ink: #0d1b2e; --muted: #526279; --line: #d9e3ef;
+  --accent: #1785c4; --accent-ink: #ffffff; --accent-soft: #e3f2fb; --glow: rgba(42,171,238,.28);
+  --code-bg: #0d1b2e; --code-ink: #dbeafe; --shadow: 0 24px 60px -24px rgba(13,27,46,.35);
+  --font: "Manrope", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
+  --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
+}
+@media (prefers-color-scheme: dark) {
+  :root {
+    --bg: #0b1424; --bg2: #101c31; --ink: #e8f0fb; --muted: #93a4bd; --line: #1f2f4a;
+    --accent: #2aabee; --accent-ink: #04121f; --accent-soft: #12304a; --glow: rgba(42,171,238,.22);
+    --code-bg: #07101d; --code-ink: #cfe6fb; --shadow: 0 24px 60px -24px rgba(0,0,0,.7);
+  }
+}
+* { box-sizing: border-box; }
+html { scroll-behavior: smooth; }
+body { margin: 0; background: var(--bg); color: var(--ink); font-family: var(--font); line-height: 1.6; -webkit-font-smoothing: antialiased; }
+img { max-width: 100%; height: auto; display: block; }
+a { color: var(--accent); }
+.wrap { width: min(1120px, 100% - 32px); margin-inline: auto; }
+section { padding: 72px 0; }
+h1, h2, h3 { line-height: 1.15; letter-spacing: -0.02em; margin: 0; }
+h2 { font-size: clamp(1.7rem, 3.6vw, 2.4rem); font-weight: 800; }
+.lead { color: var(--muted); font-size: 1.1rem; max-width: 60ch; margin: 12px 0 0; }
+.eyebrow { display: inline-block; font-size: .78rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--accent); margin-bottom: 10px; }
+.skip { position: absolute; left: -999px; top: 8px; background: var(--accent); color: var(--accent-ink); padding: 8px 14px; border-radius: 8px; z-index: 20; }
+.skip:focus { left: 8px; }
+
+/* header */
+header.top { position: sticky; top: 0; z-index: 10; backdrop-filter: blur(14px); background: color-mix(in srgb, var(--bg) 82%, transparent); border-bottom: 1px solid var(--line); }
+.bar { display: flex; align-items: center; gap: 20px; height: 64px; }
+.brand { display: flex; align-items: center; gap: 10px; font-weight: 800; color: var(--ink); text-decoration: none; letter-spacing: -0.01em; }
+.brand svg { width: 28px; height: 28px; }
+nav.main { margin-left: auto; display: flex; align-items: center; gap: 4px; }
+nav.main a { color: var(--muted); text-decoration: none; font-weight: 600; font-size: .95rem; padding: 8px 12px; border-radius: 8px; }
+nav.main a:hover { color: var(--ink); background: var(--accent-soft); }
