+/* ------------------------------------------------------------------
+ * Seekbar — premium scrub feel.
+ *
+ * Outer `#video-progress-hitzone` owns the 24 px touch target
+ * (matches iOS HIG / Material a11y baseline). The inner
+ * `#video-progress-container` holds the visual track which grows
+ * on hover/active so the bar reads "alive" without bloating the
+ * resting layout. The scrubber dot scales up + glows on active.
+ * Tuned to feel identical on mouse, pen, and touch.
+ * ------------------------------------------------------------------ */
+#video-progress-hitzone:focus {
+    outline: none;
+}
+#video-progress-hitzone:focus-visible .seekbar-track {
+    box-shadow: 0 0 0 2px rgba(80, 160, 255, 0.45);
+}
+.seekbar-track {
+    transition:
+        height 120ms ease-out,
+        transform 120ms ease-out;
+}
+/* Hover (desktop only) and active (any device) — grow the visual
+ * track from 4 px → 6 px so the played bar reads chunkier without
+ * shifting layout. The hit-zone height never changes. */
+@media (hover: hover) {
+    #video-progress-hitzone:hover .seekbar-track {
+        height: 0.375rem;
+    }
+}
+#video-progress-hitzone.is-active .seekbar-track {
+    height: 0.5rem;
+}
+.seekbar-dot {
+    width: 14px;
+    height: 14px;
+    margin-top: -7px;
+    margin-left: -7px;
+    transition:
+        transform 120ms ease-out,
+        box-shadow 160ms ease-out;
+}
+@media (hover: hover) {
+    #video-progress-hitzone:hover .seekbar-dot {
+        transform: scale(1.15);
+    }
+}
+#video-progress-hitzone.is-active .seekbar-dot {
+    transform: scale(1.45);
+    box-shadow:
+        0 0 0 6px rgba(80, 160, 255, 0.18),
+        0 2px 8px rgba(0, 0, 0, 0.4);
+}
+/* Chapter ticks — subtle vertical separators on the track, aligned
+ * to the layer width so they always sit at the right time fraction.
+ * 1 px wide, semi-transparent so they don't fight the played bar. */
+#video-chapter-layer .chapter-tick {
+    position: absolute;
+    top: -1px;
+    bottom: -1px;
+    width: 1px;
+    background: rgba(255, 255, 255, 0.55);
+    pointer-events: none;
+}
+
+/* Buffered ranges — render as light overlay segments. */
+#video-buffered-layer .buf {
+    position: absolute;
+    top: 0;
+    bottom: 0;
+    background: rgba(255, 255, 255, 0.18);
+    border-radius: 9999px;
+}
+
+/* Seekbar hover sprite preview — Netflix/YouTube style. JS sets `left`
+ * (clamped to the viewport, not just the bar) and CSS owns the chrome
+ * (rounded corners, ring, shadow, time pill, pending shimmer). On
+ * mobile the tile shrinks via media query so it always fits portrait
+ * widths without overflow. */
+#video-sprite-preview {
+    transform: translateX(-50%);
+    z-index: 35;
+    /* Smooth glide as the cursor moves. Short enough that scrubbing
+     * still feels instant — long enough to mask the per-frame snap. */
+    transition:
+        left 80ms linear,
+        opacity 120ms ease-out,
+        transform 80ms linear;
+    opacity: 1;
+    /* Pointer-events:none is already set inline so the preview never
+     * eats clicks meant for the seek bar. */
+}
+#video-sprite-preview.hidden {
+    opacity: 0;
+    pointer-events: none;
+}
+
+/* Shimmer keyframes — used by the pending skeleton tile. */
+@keyframes seekbar-shimmer {
+    0% {
+        background-position: -200% center;
+    }
+    100% {
+        background-position: 200% center;
+    }
+}
+
+#video-sprite-frame {
+    background-repeat: no-repeat;
+    image-rendering: auto;
+    will-change: background-position;
+    background-color: rgba(14, 16, 22, 0.92);
+    /* Default resting gradient — overridden inline with the real sprite
+     * when data-state="ready". */
+    background-image: linear-gradient(
+        135deg,
+        rgba(255, 255, 255, 0.04) 0%,
+        rgba(255, 255, 255, 0.07) 50%,
+        rgba(255, 255, 255, 0.04) 100%
+    );
+}
+
+/* `data-state="pending"` — skeleton tile with animated shimmer so the
+ * user sees motion, not a frozen rectangle. Works on every platform
+ * (CSS animation, no JS required). */
+#video-sprite-preview[data-state="pending"] #video-sprite-frame {
+    width: 160px;
+    height: 90px;
+    background-image: linear-gradient(
+        100deg,
+        rgba(255, 255, 255, 0) 0%,
+        rgba(255, 255, 255, 0.06) 20%,
+        rgba(255, 255, 255, 0.12) 40%,
+        rgba(255, 255, 255, 0.06) 60%,
+        rgba(255, 255, 255, 0) 80%
+    );
+    background-size: 200% 100%;
+    animation: seekbar-shimmer 1.6s linear infinite;
+}
+#video-sprite-preview[data-state="pending"] #video-sprite-pending {
+    display: flex;
+}
+/* `data-state="ready"` — sprite loaded. Stop shimmer, hide spinner. */
+#video-sprite-preview[data-state="ready"] #video-sprite-frame {
+    background-image: none;
+    animation: none;
+}
+#video-sprite-preview[data-state="ready"] #video-sprite-pending {
+    display: none !important;
+}
+/* `data-state="disabled"` — feature off or peer row. */
+#video-sprite-preview[data-state="disabled"] {
+    display: none !important;
+}
+
+/* ── Seekbar filmstrip ─────────────────────────────────────────── */
+#video-filmstrip {
+    position: relative;
+    background: rgba(0, 0, 0, 0.55);
+    border-top: 1px solid rgba(255, 255, 255, 0.07);
+    user-select: none;
+    -webkit-user-select: none;
+}
+.filmstrip-wrap {
+    position: relative;
+    display: flex;
+    align-items: stretch;
+}
+.filmstrip-time-float {
+    position: absolute;
+    top: -22px;
+    z-index: 10;
+    background: rgba(20, 22, 30, 0.9);
+    color: #fff;
+    font-size: 10px;
+    font-family: ui-monospace, monospace;
+    padding: 2px 6px;
+    border-radius: 4px;
+    pointer-events: none;
+    white-space: nowrap;
+    opacity: 0;
+    transform: translateX(-50%);
+    transition: opacity 0.1s;
+    border: 1px solid rgba(255, 255, 255, 0.12);
+}
+.filmstrip-time-float.visible {
+    opacity: 1;
+}
+.filmstrip-track {
+    display: flex;
+    overflow-x: auto;
+    overflow-y: hidden;
+    gap: 1px;
+    padding: 6px 2px;
+    scrollbar-width: none;
+    -webkit-overflow-scrolling: touch;
+    scroll-snap-type: x mandatory;
+    scroll-behavior: smooth;
+    flex: 1;
+    touch-action: pan-x;
+}
+@media (min-width: 640px) {
+    .filmstrip-track {
+        gap: 2px;
+        padding: 8px 4px;
+        scroll-snap-type: x proximity;
+    }
+}
+.filmstrip-track::-webkit-scrollbar {
+    display: none;
+}
+.filmstrip-thumb {
+    flex-shrink: 0;
+    position: relative;
+    border-radius: 4px;
+    overflow: hidden;
+    cursor: pointer;
+    scroll-snap-align: start;
+    outline: 2px solid transparent;
+    outline-offset: 0;
+    transition:
+        outline-color 0.1s,
+        filter 0.1s,
+        transform 0.12s;
+    background: #0d0d0d;
+    scroll-snap-align: start;
+}
+@media (hover: hover) {
+    .filmstrip-thumb:hover {
+        outline-color: rgba(255, 255, 255, 0.5);
+        filter: brightness(1.1);
+        z-index: 1;
+    }
+}
+.filmstrip-thumb.current {
+    outline-color: var(--tg-blue, #2aabee);
+    outline-width: 2.5px;
+    filter: brightness(1.18);
+    transform: scaleY(1.08);
+    transform-origin: bottom center;
+    z-index: 2;
+}
+.filmstrip-thumb-inner {
+    display: block;
+    width: 100%;
+    height: 100%;
+    background-repeat: no-repeat;
+    pointer-events: none;
+}
+.filmstrip-thumb-time {
+    display: none;
+}
+/* Visible timestamp chip on labelled thumbs (JS adds class .has-label) */
+.filmstrip-thumb.has-label .filmstrip-thumb-time {
+    display: block;
+    position: absolute;
+    bottom: 2px;
+    left: 50%;
+    transform: translateX(-50%);
+    font-size: 9px;
+    font-family: ui-monospace, monospace;
+    color: rgba(255, 255, 255, 0.9);
