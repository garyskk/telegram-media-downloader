+/* ============================================================
+   MOBILE NATIVE-FEEL ENHANCEMENTS
+   Momentum scroll, tap feedback, safe-area spacing.
+   ============================================================ */
+@media (max-width: 767.98px) {
+    .media-grid {
+        gap: 2px;
+        grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
+    }
+    .media-grid .media-item {
+        -webkit-tap-highlight-color: transparent;
+        transition: transform 0.1s ease;
+    }
+    .media-grid .media-item:active {
+        transform: scale(0.96);
+    }
+    #main-content {
+        -webkit-overflow-scrolling: touch;
+        overscroll-behavior-y: contain;
+        scroll-behavior: smooth;
+    }
+    .media-grid .tile-actions {
+        display: none !important;
+    }
+}
+@media (max-width: 380px) {
+    .media-grid {
+        grid-template-columns: repeat(3, 1fr);
+        gap: 1px;
+    }
+}
+
+/* ============================================================
+   Double-tap seek overlay (YouTube-style) — mobile only.
+   ============================================================ */
+#video-seek-back-overlay,
+#video-seek-fwd-overlay {
+    background: transparent;
+    transition: opacity 0.25s ease-out;
+}
+#video-seek-back-overlay > div,
+#video-seek-fwd-overlay > div {
+    background: rgba(0, 0, 0, 0.35);
+    border-radius: 50%;
+    width: 88px;
+    height: 88px;
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    justify-content: center;
+    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
+}
+
+/* Fullscreen — bump controls touch targets for mobile. */
+:fullscreen .video-controls button,
+:fullscreen .video-controls a {
+    min-width: 44px;
+    min-height: 44px;
+}
+:fullscreen #video-play-btn {
+    width: 52px;
+    height: 52px;
+}
+:fullscreen #video-skip-back,
+:fullscreen #video-skip-fwd {
+    width: 44px;
+    height: 44px;
+}
+
+/* ============================================================
+   Mobile viewport + safe areas (phones, installed PWA)
+   ============================================================ */
+
+/* 100vh on iOS/Android is the LARGEST viewport (toolbars hidden), so
+   bottom-anchored UI slid under the browser toolbar. Prefer the dynamic
+   viewport; browsers without dvh keep the Tailwind h-screen (100vh). */
+@supports (height: 100dvh) {
+    body.h-screen {
+        height: 100dvh;
+    }
+    #gallery-scope-menu {
+        max-height: calc(100dvh - 8rem);
+    }
+    .sheet-card {
+        max-height: 85dvh;
+    }
+}
+
+/* viewport-fit=cover (index.html) lets the page draw under notches and
+   the home indicator; these keep content inside the safe area. In
+   portrait the left/right insets are 0, in landscape they clear the
+   notch. */
+body {
+    padding-left: env(safe-area-inset-left);
+    padding-right: env(safe-area-inset-right);
+}
+.bottom-nav {
+    /* border-box: grow by the inset instead of squeezing the icons */
+    height: calc(56px + env(safe-area-inset-bottom));
+    padding-left: env(safe-area-inset-left);
+    padding-right: env(safe-area-inset-right);
+}
+/* id selector: the element also carries Tailwind px-3, which loads later */
+#status-bar {
+    padding-left: max(0.75rem, env(safe-area-inset-left));
+    padding-right: max(0.75rem, env(safe-area-inset-right));
+}
+#media-modal {
+    padding-left: env(safe-area-inset-left);
+    padding-right: env(safe-area-inset-right);
+}
+#modal-top-bar {
+    padding-top: max(1rem, env(safe-area-inset-top));
+}
+#modal-bottom-controls {
+    padding-bottom: env(safe-area-inset-bottom);
+}
+.sheet-card {
+    padding-bottom: calc(12px + env(safe-area-inset-bottom));
+}
+@media (max-width: 767.98px) {
+    #sidebar {
+        padding-top: env(safe-area-inset-top);
+        padding-bottom: env(safe-area-inset-bottom);
+        padding-left: env(safe-area-inset-left);
+    }
+}
+/* iOS draws white status-bar text (black-translucent) over the page.
+   Over the light theme's white header that text was invisible, so give
+   the inset strip a dark band. Zero-height outside notched standalone. */
+@media (display-mode: standalone) {
+    html.theme-light #content-header,
+    html.theme-light #sidebar {
+        box-shadow: inset 0 env(safe-area-inset-top) 0 0 #17212b;
+    }
+}
+
+/* Floating bars above the bottom nav + status bar on phones. The gallery
+   selection bar used to sit at bottom:32px — under the bottom nav — and
+   ran off-screen at 360 px; the Queue batch bar and the FAB overlapped
+   the status bar. */
+@media (max-width: 767.98px) {
+    #selection-bar,
+    #queue-selection-bar {
+        bottom: calc(56px + 28px + 8px + env(safe-area-inset-bottom));
+        left: calc(8px + env(safe-area-inset-left));
+        right: calc(8px + env(safe-area-inset-right));
+        transform: none;
+        max-width: none;
+        flex-wrap: wrap;
+        justify-content: center;
+        row-gap: 6px;
+    }
+    #selection-bar {
+        border-radius: 16px;
+        padding: 8px 10px;
+        column-gap: 10px;
+    }
+    /* Icon-only action buttons; the label stays for screen readers. */
+    #selection-zip > span,
+    #selection-pin > span,
+    #selection-delete > span {
+        position: absolute;
+        width: 1px;
+        height: 1px;
+        overflow: hidden;
+        clip: rect(0 0 0 0);
+        white-space: nowrap;
+    }
+    #selection-zip,
+    #selection-pin,
+    #selection-delete {
+        min-width: 44px;
+        min-height: 36px;
+        display: inline-flex;
+        align-items: center;
+        justify-content: center;
+    }
+    .fab {
+        bottom: calc(56px + 28px + 12px + env(safe-area-inset-bottom));
+        right: calc(16px + env(safe-area-inset-right));
+    }
+    /* The FAB floats 12 px above the status bar and is 56 px tall: room at
+       the end of every page so the last row (a Chats switch, the last
+       gallery tiles, a Settings card) scrolls clear of it. The id rule
+       beats the element's Tailwind p-2. Guests have no FAB. */
+    body:not([data-role="guest"]) #content-area {
+        padding-bottom: 80px;
+    }
+    /* The FAB would sit on top of a floating selection bar. */
+    body:has(#selection-bar:not(.hidden)) .fab,
+    body:has(#queue-selection-bar:not(.hidden)) .fab {
+        display: none;
+    }
+}
+
+/* Viewer media panes own their gestures (swipe prev/next, drag-down to
+   close, pinch / double-tap zoom). `touch-action: manipulation` on
+   <body> let the browser claim the pan first and cancel the pointer
+   stream. Text / code / PDF / markdown panes keep native scrolling. */
+#image-container,
+#video-tap-layer,
+#audio-container,
+#fallback-container,
+#office-container {
+    touch-action: none;
+}
+#modal-image.is-zoomed {
+    cursor: grab;
+}
+/* Face boxes are laid out for the unzoomed image — hide them while
+   zoomed instead of drawing them in the wrong place. */
+#image-container.is-zoomed #face-overlay-layer {
+    visibility: hidden;
+}
+
+/* Bottom sheets: a finger-sized grab area around the 36×4 handle, and a
+   44 px close button. */
+.sheet-handle {
+    position: relative;
+}
+.sheet-header .sheet-handle {
+    position: absolute;
+}
+.sheet-handle::before {
+    content: "";
+    position: absolute;
+    left: -60px;
+    right: -60px;
+    top: -10px;
+    bottom: -16px;
+    touch-action: none;
+}
+.sheet-close {
+    min-width: 44px;
+    min-height: 44px;
+    margin-right: -10px;
+}
+
+/* Touch screens have no hover: keep the mini-player controls visible, and
+   don't leave an invisible (but tappable) pin target on unpinned tiles. */
+@media (hover: none) {
+    .mini-player-bar {
+        opacity: 1;
+    }
+    .media-item:not(.is-pinned) .pin-chip {
+        display: none;
+    }
+}
+
+/* Nothing fills the viewer's preview strip yet — don't reserve a 72 px
+   empty band between the media and the info bar. */
+#preview-strip-container:not(:has(#preview-strip > *)) {
+    display: none;
+}
+
+/* ── Gallery toolbar: search + Sort & filter (js/gallery-toolbar.js) ──
+   Phones: the search row sits above the type tabs (order -1, full
+   width). md+: one row — tabs left, search + filter button right. */
+.gallery-search-row {
+    order: -1;
+    flex: 1 0 100%;
+    display: flex;
+    align-items: center;
+    gap: 6px;
+    padding: 8px 6px 4px;
+    min-width: 0;
+}
+@media (min-width: 768px) {
+    .gallery-search-row {
+        order: 0;
+        flex: 0 1 380px;
+        margin-left: auto;
+        padding: 6px 8px 6px 12px;
+    }
+    #gallery-scope-chip:not(.hidden) ~ .gallery-search-row {
+        margin-left: 4px;
+    }
+}
+.gallery-search {
+    position: relative;
+    flex: 1 1 auto;
+    min-width: 0;
+    display: flex;
+    align-items: center;
+    height: 40px;
+    border-radius: 10px;
+    background: var(--tg-panel);
+    border: 1px solid transparent;
+    transition:
+        border-color 0.15s ease,
+        box-shadow 0.15s ease;
+}
+.gallery-search:focus-within {
+    border-color: var(--tg-blue);
+    box-shadow: 0 0 0 3px rgba(42, 171, 238, 0.18);
+}
+.gallery-search-icon {
+    position: absolute;
+    left: 12px;
+    font-size: 17px;
+    color: var(--tg-textSecondary);
+    pointer-events: none;
+}
+#gallery-search-input {
+    flex: 1 1 auto;
