+        state: 'done',
+        processed: 120,
+        downloaded: 14,
+        error: null,
+        group: G.alpha.name,
+        groupId: G.alpha.id,
+        limit: 100,
+        startedAt: T('2024-06-10T08:00:00'),
+        finishedAt: T('2024-06-10T08:05:00'),
