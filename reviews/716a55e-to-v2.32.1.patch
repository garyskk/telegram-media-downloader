+/* ===================================================================
+   v2.6.0 — Gallery + viewer polish (right-click menu, drag-drop,
+   pin / favourite, mini-player, ZIP, dragdrop overlay).
+   =================================================================== */
+
+/* Pin chip in the gallery tile header. Shown only when `is-pinned` is
+   set on the tile, hidden otherwise. Sits inside the existing
+   `.media-item` so it scrolls with the gallery. */
+.media-item .pin-chip {
+    position: absolute;
+    top: 6px;
+    left: 6px;
+    width: 26px;
+    height: 26px;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    border-radius: 999px;
+    background: rgba(0, 0, 0, 0.55);
+    color: #ffd54f;
+    font-size: 14px;
+    pointer-events: auto;
+    cursor: pointer;
+    opacity: 0;
+    transition: opacity 0.12s ease;
+    z-index: 4;
+}
+.media-item:hover .pin-chip,
+.media-item.is-pinned .pin-chip {
+    opacity: 1;
+}
+.media-item .pin-chip:hover {
+    background: rgba(0, 0, 0, 0.75);
+}
+.media-item.is-pinned .pin-chip {
+    color: #ffd54f;
+}
+.media-item:not(.is-pinned) .pin-chip {
+    color: rgba(255, 255, 255, 0.65);
+}
+
+/* Pinned filter chip — sits at the right end of #media-tabs as a
+   capsule-shaped toggle. Visually distinct from the underline-style
+   type tabs (All / Photos / Videos / …) because it STACKS with the
+   active type rather than replacing it. */
+#media-tabs .tab-item:not(.tab-item--toggle) + .tab-item--toggle {
+    margin-left: auto;
+}
+#media-tabs .tab-item--toggle + .tab-item--toggle {
+    margin-left: 6px;
+}
+#media-tabs .tab-item--toggle {
+    flex: 0 0 auto;
+    align-self: center;
+    display: inline-flex;
+    align-items: center;
+    gap: 4px;
+    height: 28px;
+    padding: 0 10px;
+    border-radius: 999px;
+    border: 1px solid var(--tg-border, #0d1117);
+    color: var(--tg-textSecondary, #8b9baa);
+    background: var(--tg-bg, #17212b);
+    font-size: 12px;
+    cursor: pointer;
+    user-select: none;
+    font-size: 12px;
+    font-weight: 500;
+    line-height: 1;
+    white-space: nowrap;
+    flex-shrink: 0;
+    transition:
+        background 140ms ease,
+        border-color 140ms ease,
+        color 140ms ease,
+        transform 140ms ease;
+}
+/* Override the inherited .tab-item bottom-border + active::after marker —
+   this chip uses background, not an underline, so the leftover border
+   from .tab-item created a stray line under the capsule. */
+#media-tabs .tab-item--toggle.active,
+#media-tabs .tab-item--toggle {
+    border-bottom: 1px solid var(--tg-border, #0d1117);
+}
+#media-tabs .tab-item--toggle::after {
+    display: none !important;
+}
+#media-tabs .tab-item--toggle i {
+    font-size: 14px;
+    color: var(--tg-textSecondary, #8b9baa);
+    transition:
+        color 140ms ease,
+        transform 200ms ease;
+}
+#media-tabs .tab-item--toggle:hover {
+    color: var(--tg-text, #f5f5f5);
+    border-color: var(--tg-textSecondary, #8b9baa);
+    background: var(--tg-hover, #2b5278);
+}
+#media-tabs .tab-item--toggle:hover i {
+    color: var(--tg-blue, #2aabee);
+}
+#media-tabs .tab-item--toggle[aria-pressed="true"] {
+    background: var(--tg-blue, #2aabee);
+    color: #ffffff;
+    border-color: var(--tg-blue, #2aabee);
+}
+#media-tabs .tab-item--toggle[aria-pressed="true"] i {
+    color: #ffffff;
+    transform: rotate(-12deg);
+}
+#media-tabs .tab-item--toggle:active {
+    transform: scale(0.97);
+}
+@media (prefers-reduced-motion: reduce) {
+    #media-tabs .tab-item--toggle,
+    #media-tabs .tab-item--toggle i {
+        transition: none;
+    }
+    #media-tabs .tab-item--toggle:active {
+        transform: none;
+    }
+}
+@media (max-width: 639px) {
+    #media-tabs .tab-item--toggle {
+        padding: 0 8px;
+        height: 26px;
+    }
+    #media-tabs .tab-item--toggle span {
+        display: none;
+    }
+    #media-tabs .tab-item--toggle i {
+        margin: 0;
+    }
+}
