+        const until = Number(String(access.detail).slice(6)) * 1000;
+        if (until > Date.now()) {
+            text += ` ${i18nTf('access.reason.banned_until', { when: new Date(until).toLocaleString() }, `The ban ends ${new Date(until).toLocaleString()}.`)}`;
+        }
+    }
+    return text;
