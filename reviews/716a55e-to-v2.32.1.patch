+	syscall.ENOPROTOOPT:     "ENOPROTOOPT",
+	syscall.ENOSPC:          "ENOSPC",
+	syscall.ENOSYS:          "ENOSYS",
+	syscall.ENOTCONN:        "ENOTCONN",
+	syscall.ENOTDIR:         "ENOTDIR",
