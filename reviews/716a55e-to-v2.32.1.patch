+   content column (no full-width breakout) so it doesn't read
+   as a foreign banner pasted on top of the cards.
+   ============================================================ */
+/* Advanced collapsible (v2.9 declutter). The Settings page wraps its
+   30+ power-user tunables in a <details> so they're hidden by default.
+   Suppress the browser's default disclosure marker and rotate our own
+   chevron when open. */
+#settings-card-advanced-details > summary {
+    list-style: none;
+}
+#settings-card-advanced-details > summary::-webkit-details-marker {
+    display: none;
+}
+#settings-card-advanced-details > summary::marker {
+    content: "";
+}
+#settings-card-advanced-details[open] > summary .details-marker {
+    transform: rotate(180deg);
+}
+#settings-card-advanced-details > summary .details-marker {
+    transition: transform 150ms ease;
+}
+
+.settings-chip-nav {
+    position: sticky;
+    top: 0;
+    z-index: 5;
+    display: flex;
+    margin: 0 0 16px;
+    padding: 0;
+    background: var(
+        --tg-bg,
+        #17212b
+    ); /* matches page bg so scrolled cards pass cleanly underneath */
+    border-bottom: 1px solid var(--tg-border, #0d1117);
+    overflow-x: auto;
+    overflow-y: hidden;
+    -webkit-overflow-scrolling: touch;
+    scrollbar-width: none;
+}
+.settings-chip-nav::-webkit-scrollbar {
     display: none;
