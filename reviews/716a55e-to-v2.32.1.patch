+        out.push(abs);
+    };
+    add(getDownloadsDir());
+    add(path.join(getDataDir(), 'downloads'));
+    const custom = config?.download?.path;
+    if (typeof custom === 'string' && custom.trim()) add(resolveConfigDownloadPath(custom));
