+/** Group slug a tool belongs to, or null for an unknown tool. */
+export function groupOfTool(tool) {
+    return _groupOf.get(tool) || null;
+}
+
+export function getGroup(slug) {
+    return TOOL_GROUPS.find((g) => g.slug === slug) || null;
