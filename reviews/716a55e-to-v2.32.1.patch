+        `<button type="button" class="${migrated ? 'tg-btn-secondary' : 'tg-btn'}" data-cd-access="recheck"><i class="ri-refresh-line" aria-hidden="true"></i><span>${escapeHtml(i18nT('access.action.recheck', 'Check again'))}</span></button>`,
+    );
