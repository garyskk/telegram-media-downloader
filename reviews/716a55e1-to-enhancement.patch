+    delete process.env.TGDL_SIMILAR_THRESHOLD;
+    delete process.env.TGDL_SIMILAR_PARTIAL_FRAME_THRESHOLD;
+    delete process.env.TGDL_SIMILAR_SCENE_THRESHOLD;
+    delete process.env.TGDL_SIMILAR_FLOOR_INTERVAL_SEC;
