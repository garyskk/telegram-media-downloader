+export function hammingHex(a, b) {
+    const x = BigInt(`0x${a}`) ^ BigInt(`0x${b}`);
+    let n = 0;
+    let v = x;
+    while (v) {
+        n += Number(v & 1n);
+        v >>= 1n;
+    }
+    return n;
+}
+
+export function xorAggregate(hexes) {
+    let acc = 0n;
+    let width = 16;
+    for (const h of hexes || []) {
+        if (!h) continue;
+        width = Math.max(width, String(h).length);
+        acc ^= BigInt(`0x${h}`);
+    }
+    return acc.toString(16).padStart(width, '0');
