+            ids.length > 1
+                ? i18nTf(
+                      'maintenance.ai.unclassified.removed_n',
+                      { n: ids.length },
+                      `${ids.length} faces removed`,
+                  )
+                : i18nT('maintenance.ai.unclassified.removed', 'Face removed'),
+            'success',
